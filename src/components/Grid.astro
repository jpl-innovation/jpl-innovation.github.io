---
interface Props {
	variant?: 'offset' | 'small';
}

const { variant } = Astro.props;
---

<ul class:list={['grid', { offset: variant === 'offset', small: variant === 'small' }]}>
	<slot />
</ul>

<style>
	.grid {
		display: grid;
		grid-auto-rows: 1fr;
		gap: 1rem;
		list-style: none;
		padding: 0;
	}

	.grid.small {
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
	}

	/* If last row contains only one item, make it span both columns. */
	.grid.small > :global(:last-child:nth-child(odd)) {
		grid-column: 1 / 3;
	}

	@media (min-width: 50em) {
		.grid {
			grid-template-columns: repeat(3, 1fr);
			gap: 2.5rem;
		}

		.grid.offset {
			--row-offset: 5rem;
			padding-bottom: var(--row-offset);
		}

		/* Shift odd items vertically for staggered effect */
		.grid.offset > :global(:nth-child(odd)) {
			transform: translateY(var(--row-offset));
		}

		/* Last item positioning for offset grid */
		.grid.offset > :global(:last-child:nth-child(3n+2)) {
			grid-column: 2 / 3;
			transform: none;
		}

		/* Exactly two items: two columns, so there's no empty third column. */
		.grid.offset:has(> :global(:last-child:nth-child(2))) {
			grid-template-columns: repeat(2, 1fr);
			max-width: 52rem;
		}

		.grid.small {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 2rem;
		}

		.grid.small > :global(*) {
			flex-basis: 20rem;
		}
	}
</style>
