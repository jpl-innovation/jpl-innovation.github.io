---
/**
 * Top-down F450 quadcopter (quad-X). Front is up; the front arms are red like the real frame.
 * Props spin in the standard pattern: front-left & rear-right CW, front-right & rear-left CCW.
 * Drawn roughly to scale: 10" props on 450 mm motor-to-motor diagonal.
 */
const motors = [
	{ x: 100, y: 100, dir: "cw", front: true },
	{ x: 300, y: 100, dir: "ccw", front: true },
	{ x: 100, y: 300, dir: "ccw", front: false },
	{ x: 300, y: 300, dir: "cw", front: false },
];
---

<svg
	class="drone"
	viewBox="0 0 400 400"
	role="img"
	aria-label="Top-down illustration of the F450 quadcopter with spinning propellers"
>
	<defs>
		<radialGradient id="prop-disc">
			<stop offset="0.25" stop-color="currentColor" stop-opacity="0" />
			<stop offset="0.9" stop-color="currentColor" stop-opacity="0.16" />
			<stop offset="1" stop-color="currentColor" stop-opacity="0.35" />
		</radialGradient>
	</defs>

	<g class="body">
		<!-- Arms -->
		{
			motors.map((m) => (
				<line x1="200" y1="200" x2={m.x} y2={m.y} class:list={["arm", { front: m.front }]} />
			))
		}

		<!-- Motors & propellers -->
		{
			motors.map((m) => (
				<g transform={`translate(${m.x} ${m.y})`}>
					<circle r="80" fill="url(#prop-disc)" />
					<g class:list={["prop", m.dir]}>
						<ellipse rx="74" ry="6.5" />
					</g>
					<circle r="19" class="motor" />
					<circle r="6" class="hub" />
				</g>
			))
		}

		<!-- Center plate, flight controller, and camera (front) -->
		<rect x="148" y="148" width="104" height="104" rx="26" class="plate" />
		<rect x="179" y="179" width="42" height="42" rx="6" class="fc" />
		<circle cx="200" cy="200" r="4" class="led" />
		<rect x="187" y="136" width="26" height="16" rx="4" class="cam" />
		<circle cx="200" cy="144" r="4" class="lens" />

		<!-- 4G signal -->
		<g class="signal" transform="translate(200 232)">
			<path d="M-10 14a14 14 0 0 1 20 0" />
			<path d="M-18 22a26 26 0 0 1 36 0" />
		</g>
	</g>
</svg>

<style>
	/* Colours follow the site palette; front arms are red like the real frame. */
	.drone {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
		color: var(--alliance-blue);
	}

	.arm {
		stroke: var(--muted-foreground);
		stroke-width: 14;
		stroke-linecap: round;
	}

	.arm.front {
		stroke: var(--alliance-red);
	}

	.prop ellipse {
		fill: var(--foreground);
		opacity: 0.55;
	}

	.prop {
		transform-box: fill-box;
		transform-origin: center;
		animation: spin 0.32s linear infinite;
	}

	/* On load: the props spin up, then the drone lifts off (only when motion is allowed). */
	:global(.motion) .prop {
		animation:
			spinup 1.1s ease-in both,
			spin 0.32s linear 1.1s infinite;
	}
	:global(.motion) .body {
		transform-box: fill-box;
		transform-origin: center;
		animation: liftoff 1.3s cubic-bezier(0.16, 1, 0.3, 1) 0.5s both;
	}

	.prop.ccw {
		animation-direction: reverse;
	}

	.motor {
		fill: var(--card);
		stroke: var(--foreground);
		stroke-width: 3;
	}

	.hub,
	.led,
	.lens {
		fill: var(--accent);
	}

	.plate {
		fill: var(--foreground);
	}

	.fc {
		fill: var(--background);
		stroke: var(--accent);
		stroke-width: 2.5;
	}

	.cam {
		fill: var(--foreground);
		stroke: var(--muted-foreground);
		stroke-width: 2;
	}

	.signal path {
		fill: none;
		stroke: var(--accent);
		stroke-width: 3;
		stroke-linecap: round;
	}

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}
	@keyframes spinup {
		to {
			transform: rotate(720deg);
		}
	}
	@keyframes liftoff {
		from {
			transform: translateY(18px) scale(0.94);
		}
	}
</style>
