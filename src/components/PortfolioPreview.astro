---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
	project: CollectionEntry<'work'>;
}

const { data, id } = Astro.props.project;
---

<a class="card" href={`/work/${id}/`}>
	<img src={data.img} alt={data.img_alt || ''} loading="lazy" decoding="async" />
	{data.badge && (
		<span class="badge">
			<span class="badge-dot" aria-hidden="true" />
			{data.badge}
		</span>
	)}
	<span class="title">
		{data.title}
		<span class="arrow"><Icon icon="arrow-right" /></span>
	</span>
</a>

<style>
	.card {
		position: relative;
		display: grid;
		grid-template: 1fr / 1fr;
		height: 14rem;
		isolation: isolate;
		background: var(--gray-900);
		border: 1px solid var(--border-subtle);
		border-radius: 1rem;
		overflow: hidden;
		box-shadow: var(--shadow-md);
		text-decoration: none;
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 500;
		transition:
			transform var(--ease-duration) var(--ease-out),
			box-shadow var(--ease-duration) var(--ease-out),
			border-color var(--ease-duration) var(--ease-out);
	}

	/* Gradient scrim so the title stays readable over any photo. */
	.card::after {
		content: '';
		grid-area: 1 / 1;
		z-index: 1;
		background: linear-gradient(to top, rgba(9, 11, 17, 0.75) 0%, rgba(9, 11, 17, 0.1) 45%, transparent 70%);
		pointer-events: none;
	}

	img {
		grid-area: 1 / 1;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 700ms var(--ease-out);
	}

	.title {
		grid-area: 1 / 1;
		z-index: 2;
		align-self: end;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 1.25rem;
		color: #fff;
		text-shadow: 0 1px 8px rgba(0, 0, 0, 0.4);
	}

	.badge {
		grid-area: 1 / 1;
		z-index: 2;
		align-self: start;
		justify-self: start;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0.9rem;
		padding: 0.3rem 0.75rem;
		border-radius: 999rem;
		background: rgba(9, 11, 17, 0.6);
		backdrop-filter: blur(8px);
		color: #fff;
		font-family: var(--font-body);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.02em;
	}

	.badge-dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: #5cc8ff;
		box-shadow: 0 0 0 3px rgba(92, 200, 255, 0.3);
	}

	.arrow {
		display: flex;
		padding: 0.5rem;
		border-radius: 999rem;
		background: rgba(255, 255, 255, 0.15);
		backdrop-filter: blur(6px);
		transition: transform var(--ease-duration) var(--ease-out), background-color var(--ease-duration) ease;
	}

	.card:hover,
	.card:focus-visible {
		transform: translateY(-6px);
		box-shadow: var(--shadow-lg);
		border-color: var(--border-accent);
	}

	.card:hover img,
	.card:focus-visible img {
		transform: scale(1.06);
	}

	.card:hover .arrow,
	.card:focus-visible .arrow {
		transform: translateX(4px);
		background: var(--accent-regular);
	}

	@media (min-width: 50em) {
		.card {
			height: 22rem;
			border-radius: 1.5rem;
		}

		.title {
			padding: 1.5rem 1.75rem;
			font-size: var(--text-xl);
		}
	}
</style>
