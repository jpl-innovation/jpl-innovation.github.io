---
import Icon from "./Icon.astro";
---

<section class="box surface skills">
	<div class="stack gap-2 lg:gap-4">
		<Icon
			icon="rocket-launch"
			color="var(--accent-regular)"
			size="2.5rem"
			gradient
		/>
		<h2>Innovation</h2>
		<p>Build, test, and improve ideas quickly.</p>
	</div>
	<div class="stack gap-2 lg:gap-4">
		<Icon
			icon="strategy"
			color="var(--accent-regular)"
			size="2.5rem"
			gradient
		/>
		<h2>Collaboration</h2>
		<p>Share knowledge and ship together.</p>
	</div>
	<div class="stack gap-2 lg:gap-4">
		<Icon
			icon="heart"
			color="var(--accent-regular)"
			size="2.5rem"
			gradient
		/>
		<h2>Impact</h2>
		<p>Make solutions that help people.</p>
	</div>
</section>

<style>
	.box {
		border-radius: 0.75rem;
		padding: 1.5rem;
	}

	.skills {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.skills h2 {
		font-size: var(--text-lg);
	}

	.skills p {
		color: var(--gray-400);
	}

	@media (min-width: 50em) {
		.box {
			border-radius: 1.5rem;
			padding: 2.5rem;
		}

		.skills {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 5rem;
		}

		.skills h2 {
			font-size: var(--text-2xl);
		}
	}
</style>
