---
import { Moon, Sun } from "lucide-react";
---

<button
	type="button"
	data-theme-toggle
	class="inline-flex size-11 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground"
>
	<span class="sr-only">Switch between light and dark theme</span>
	<Sun className="size-5 dark:hidden" aria-hidden="true" />
	<Moon className="hidden size-5 dark:block" aria-hidden="true" />
</button>

<script>
	// Delegated once, so it keeps working after client-side page swaps.
	document.addEventListener("click", (event) => {
		if (!(event.target as Element).closest("[data-theme-toggle]")) return;
		const dark = document.documentElement.classList.toggle("dark");
		try {
			localStorage.setItem("theme", dark ? "dark" : "light");
		} catch {}
	});
</script>
