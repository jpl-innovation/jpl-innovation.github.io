---
import ContactDialog from "./contact-dialog";
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
const links = [
	{ label: "Work", href: "/work/" },
	{ label: "FIRST Robotics", href: "/work/frc/" },
	{ label: "F450 4G Drone", href: "/work/drone/" },
	{ label: "Cybersecurity", href: "/work/cybersecurity/" },
	{ label: "Members", href: "/members/" },
];
const linkClass = "press inline-flex min-h-11 items-center underline-offset-4 hover:text-foreground hover:underline";
---

<footer class="border-t">
	<div class="wrapper grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
		<div class="flex max-w-xs flex-col gap-4">
			<a href="/" class="press w-fit" aria-label="JPL Innovation home"><Logo class="h-12" /></a>
			<p class="text-sm text-muted-foreground">
				A student-led engineering team at Saigon South International School, Ho Chi Minh City. Part of FRC Team 10951.
			</p>
		</div>
		<nav aria-label="Footer">
			<h2 class="mb-1 text-sm font-semibold">Pages</h2>
			<ul class="flex flex-col text-sm text-muted-foreground">
				{links.map((l) => <li><a class={linkClass} href={l.href}>{l.label}</a></li>)}
			</ul>
		</nav>
		<div>
			<h2 class="mb-1 text-sm font-semibold">Contact</h2>
			<ul class="flex flex-col text-sm text-muted-foreground">
				<li><ContactDialog client:visible look="link" label="antruongphs2@gmail.com" /></li>
				<li><a class={linkClass} href="https://github.com/jpl-innovation" target="_blank" rel="noopener noreferrer">GitHub</a></li>
			</ul>
		</div>
	</div>
	<div class="wrapper border-t py-5 text-sm text-muted-foreground">
		&copy; {year} JPL Innovation
	</div>
</footer>
