---
import Icon from "./Icon.astro";
---

<section class="mission">
	<div class="mission-text stack gap-4">
		<h2>Our mission</h2>
		<p>
			At JPL Innovation, we believe technology is a tool for impact. Our mission is to keep pushing our skills
			through ambitious builds, thoughtful experimentation, and consistent collaboration.
		</p>
	</div>
	<div class="mission-card box stack gap-2">
		<div class="card-header">
			<Icon icon="trophy" color="var(--accent-regular)" size="1.5rem" gradient />
			<div>
				<p class="eyebrow">What we optimize for</p>
				<h3>Progress you can see</h3>
			</div>
		</div>
		<ul>
			<li>Projects that are demoable, measurable, and improving over time.</li>
			<li>Clean foundations: documentation, version control, and repeatable setups.</li>
			<li>Real-world skills: problem-solving, communication, and teamwork.</li>
		</ul>
	</div>
</section>

<style>
	.mission {
		display: grid;
		gap: 2rem;
	}

	.mission-text h2 {
		font-size: var(--text-2xl);
	}

	.mission-text p {
		color: var(--gray-300);
		font-size: var(--text-md);
		max-width: 50ch;
	}

	.box {
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 0.75rem;
		padding: 1.5rem;
		background: linear-gradient(135deg,
			rgba(29, 174, 241, 0.03) 0%,
			rgba(255, 255, 255, 0.02) 100%);
		box-shadow: var(--shadow-sm);
		transition: all 300ms ease;
	}

	.box:hover {
		border-color: rgba(29, 174, 241, 0.2);
		background: linear-gradient(135deg,
			rgba(29, 174, 241, 0.08) 0%,
			rgba(255, 255, 255, 0.04) 100%);
		box-shadow: var(--shadow-md);
		transform: translateY(-2px);
	}

	.card-header {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.eyebrow {
		font-size: var(--text-sm);
		color: var(--gray-400);
		margin: 0;
	}

	.mission-card h3 {
		font-size: var(--text-md);
		margin: 0;
	}

	.mission-card ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.mission-card li {
		color: var(--gray-400);
		font-size: var(--text-sm);
		padding-left: 1.25rem;
		position: relative;
	}

	.mission-card li::before {
		content: "✓";
		position: absolute;
		left: 0;
		color: var(--accent-regular);
	}

	@media (min-width: 50em) {
		.mission {
			grid-template-columns: 1fr 1fr;
			gap: 3rem;
			align-items: center;
		}

		.mission-text h2 {
			font-size: var(--text-3xl);
		}

		.mission-text p {
			font-size: var(--text-lg);
		}

		.box {
			border-radius: 1.5rem;
			padding: 2.5rem;
		}

		.mission-card h3 {
			font-size: var(--text-lg);
		}

		.mission-card li {
			font-size: var(--text-md);
		}
	}
</style>
