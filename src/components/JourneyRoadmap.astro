---
const milestones = [
	{
		label: "2023 · Past",
		title: "Foundation & exploration",
		desc: "Learned programming fundamentals, explored different tools, and built first projects.",
	},
	{
		label: "2024 · Past",
		title: "Project development",
		desc: "Expanded hands-on experience through robotics and software builds and grew our portfolio.",
	},
	{
		label: "2025 · Present",
		title: "Innovation & growth",
		desc: "Strengthening full-stack foundations, improving quality, and growing the JPL Innovation site and project list.",
		current: true,
	},
	{
		label: "2026 · Near future",
		title: "Professional development",
		desc: "Take on bigger builds, contribute to open-source, and pursue internships while sharpening real-world skills.",
	},
	{
		label: "2027–2028 · Future",
		title: "Industry leadership",
		desc: "Lead projects with strong engineering habits and deliver tools that help real users.",
	},
	{
		label: "2029+ · Long-term",
		title: "Creating the future",
		desc: "Build larger impact projects, mentor others, and keep learning as technology evolves.",
	},
];
---

<section class="section with-background">
	<header class="section-header stack gap-2 lg:gap-4">
		<h3>Journey & roadmap</h3>
		<p>Past work and where we're heading next.</p>
	</header>

	<ol class="timeline">
		{
			milestones.map((item) => (
				<li class:list={["timeline-item", item.current && "current"]}>
					<span class="dot" />
					<div class="timeline-content stack gap-1">
						<p class="label">{item.label}</p>
						<h4>{item.title}</h4>
						<p class="desc">{item.desc}</p>
					</div>
				</li>
			))
		}
	</ol>
</section>

<style>
	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);

		content: "";
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: 0;
		transform: translateY(-75%) translateX(-50%);
		background:
			url("/assets/backgrounds/noise.png") top center/220px repeat,
			var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
			var(--gray-999);
		background-blend-mode: overlay, normal, normal, normal;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header h3 {
		font-size: var(--text-2xl);
	}

	.timeline {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		padding: 1.5rem;
		background-color: var(--gray-999_40);
		box-shadow: var(--shadow-sm);
	}

	.timeline-item {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 1rem;
		align-items: start;
	}

	.dot {
		width: 0.75rem;
		height: 0.75rem;
		margin-top: 0.35rem;
		border-radius: 50%;
		background: var(--gray-600);
		border: 2px solid var(--gray-500);
	}

	.current .dot {
		background: var(--accent-regular);
		border-color: var(--accent-regular);
		box-shadow: 0 0 0 3px var(--accent-subtle-overlay);
	}

	.label {
		font-size: var(--text-sm);
		color: var(--gray-400);
		margin: 0;
	}

	.current .label {
		color: var(--accent-regular);
	}

	.timeline-content h4 {
		font-size: var(--text-md);
		margin: 0;
	}

	.desc {
		font-size: var(--text-sm);
		color: var(--gray-400);
		margin: 0;
	}

	@media (min-width: 50em) {
		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: "header header header header" "content content content content";
			gap: 3rem;
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h3 {
			font-size: var(--text-4xl);
		}

		.timeline {
			grid-area: content;
			border-radius: 1.5rem;
			padding: 2.5rem;
			gap: 2rem;
		}

		.timeline-content h4 {
			font-size: var(--text-lg);
		}

		.desc {
			font-size: var(--text-md);
		}
	}
</style>
