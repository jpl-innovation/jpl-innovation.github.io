---
import type { CollectionEntry } from "astro:content";

interface Props {
	member: CollectionEntry<"members">;
}

const { data, id } = Astro.props.member;
---

<a class="card" href={`/members/${id}`}>
	<div class="image-wrap">
		<img
			src={data.img}
			alt={data.img_alt || data.title}
			loading="lazy"
			decoding="async"
		/>
	</div>
	<span class="title">{data.title}</span>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		height: 100%;
		min-height: 16rem;
		background: linear-gradient(135deg, var(--gray-900) 0%, rgba(29, 174, 241, 0.04) 100%);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 0.75rem;
		overflow: hidden;
		box-shadow: var(--shadow-md);
		text-decoration: none;
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 500;
		transition: all 320ms cubic-bezier(.2,.9,.2,1);
	}

	.card:hover {
		box-shadow: var(--shadow-lg);
		border-color: rgba(29, 174, 241, 0.25);
		transform: translateY(-8px);
		background: linear-gradient(135deg, var(--gray-900) 0%, rgba(29, 174, 241, 0.08) 100%);
	}

	.image-wrap {
		display: flex;
		flex: 1;
		align-items: flex-start;
		justify-content: center;
		min-height: 11rem;
		padding: 1rem 1rem 0;
		background: var(--gray-900);
	}

	img {
		width: 100%;
		max-height: 12rem;
		object-fit: contain;
		object-position: top center;
	}

	.title {
		padding: 1rem 1.25rem;
		background: var(--gray-999);
		color: var(--gray-200);
		border-top: 1px solid var(--gray-800);
	}

	@media (min-width: 50em) {
		.card {
			min-height: 24rem;
			border-radius: 1.5rem;
		}

		.image-wrap {
			min-height: 18rem;
			padding: 1.5rem 1.5rem 0;
		}

		img {
			max-height: 16rem;
		}
	}
</style>
