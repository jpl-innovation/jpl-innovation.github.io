---
/** One row of the "Hardware we use" spec sheet (see HardwareStack.astro). */
import type { HardwareItem } from "@/data/frc";

interface Props {
	item: HardwareItem;
}

const { item } = Astro.props;
---

<li class="flex flex-col gap-3 border-t py-5">
	<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
		<h4 class="font-semiwide text-lg font-[760]">{item.name}</h4>
		<span class="text-sm font-medium text-muted-foreground">{item.maker}</span>
	</div>
	<p class="max-w-[60ch] text-muted-foreground">{item.desc}</p>
	<ul class="flex flex-wrap gap-2" aria-label={`${item.name} specs`}>
		{
			item.specs.map((spec) => (
				<li class="inline-flex items-baseline gap-1.5 rounded-md border bg-background px-2.5 py-1 text-[13px] leading-tight">
					<span class="font-semibold tabular-nums">{spec.value}</span>
					{spec.label && <span class="text-muted-foreground">{spec.label}</span>}
				</li>
			))
		}
	</ul>
</li>
