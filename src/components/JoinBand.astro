---
import ContactDialog from "./contact-dialog";
---

<section class="bg-accent text-accent-foreground" aria-labelledby="join-heading">
	<div class="wrapper flex flex-col gap-6 py-16 md:flex-row md:items-end md:justify-between md:py-20">
		<div class="flex max-w-2xl flex-col gap-3" data-reveal>
			<h2 id="join-heading" class="font-wide text-[clamp(1.9rem,4vw,3rem)] font-[850]">Build with us in 2027.</h2>
			<p class="text-lg">
				We're recruiting students for mechanical, electrical and software, and looking for sponsors for our second FRC season.
			</p>
		</div>
		<ContactDialog client:visible subject="Joining or sponsoring JPL Innovation" className="shrink-0" />
	</div>
</section>
