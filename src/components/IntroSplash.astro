---
/**
 * Animated logo intro ("build, then boot"), shown once per browser session on the first page load.
 *
 *   Turn it off: remove <IntroSplash /> from src/layouts/BaseLayout.astro. Nothing else depends on it.
 *   Logo:        src/assets/intro/jpl-logo.svg (generated by scripts/build-intro-svg.mjs from the traced logo)
 *   Animation:   src/scripts/intro-splash.ts
 *   Replay it:   add ?intro to any URL (it normally plays once per browser session)
 *
 * Goes in <head>. The overlay's markup is in the initial HTML as a <template>; the inline script below
 * decides whether to play and, if so, puts it on the page right there, while <head> is still being parsed.
 * So it's already showing in the very first painted frame and the page never flashes behind it, and on
 * later visits the template just sits unused. Without JavaScript it never shows; if the animation script
 * fails to load, a CSS failsafe fades the overlay out after a few seconds.
 */
import logo from "@/assets/intro/jpl-logo.svg?raw";
---

<template id="jl-intro">
<div class="intro-splash" data-intro aria-hidden="true">
	<div class="intro-bg" data-intro-bg>
		<div class="intro-grid"></div>
		<span class="intro-trace" style="--y: 22%; --d: 0s"></span>
		<span class="intro-trace" style="--y: 61%; --d: 1.1s"></span>
		<span class="intro-trace intro-trace--v" style="--x: 18%; --d: 0.5s"></span>
		<span class="intro-trace intro-trace--v" style="--x: 83%; --d: 1.6s"></span>
	</div>
	<div class="intro-stage">
		<div class="intro-logo" data-intro-logo>
			<div class="intro-parallax" data-intro-parallax set:html={logo} />
		</div>
	</div>
	<button type="button" class="intro-skip" data-intro-skip tabindex="-1">
		Skip
		<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M4 3l5 5-5 5M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
	</button>
</div>
</template>

<script is:inline>
	// Blocking, in <head>: runs before the page's first paint.
	(() => {
		const root = document.documentElement;
		try {
			const replay = /[?&]intro(=|&|$)/.test(location.search);
			if (sessionStorage.getItem("jpl-intro") === "done" && !replay) return;
		} catch {
			return; // storage blocked: skip the intro rather than replay it on every page
		}
		const tpl = document.getElementById("jl-intro");
		if (!tpl) return;
		root.classList.add("intro");
		if (matchMedia("(prefers-reduced-motion: reduce)").matches) root.classList.add("intro-reduced");
		// <body> doesn't exist yet, so the overlay goes straight under <html>; it's position: fixed on top anyway.
		root.appendChild(tpl.content.cloneNode(true));
	})();
</script>

<script>
	import "@/scripts/intro-splash";
</script>

<style is:global>
	/* Hidden unless the inline script above chose to play it. */
	.intro-splash {
		display: none;
	}
	html.intro .intro-splash {
		display: block;
		position: fixed;
		inset: 0;
		z-index: 200;
		overflow: hidden;
		cursor: pointer;
		user-select: none;
		-webkit-tap-highlight-color: transparent;
		/* If the script never starts, get out of the way (the script cancels this as soon as it runs). */
		animation: intro-failsafe 0.4s ease-out 4.5s forwards;
	}
	html.intro-live .intro-splash {
		animation: none;
	}
	@keyframes intro-failsafe {
		to {
			opacity: 0;
			visibility: hidden;
		}
	}
	/* Only colours change, never the scrollbar's width, so nothing shifts. Back to normal as the overlay fades. */
	html.intro:not(.intro-leaving) {
		scrollbar-color: #1e3f78 #0a1a3a;
	}
	/* The navbar logo waits for the splash logo to land on it. */
	html.intro:not(.intro-reduced) [data-site-header] [data-site-logo] {
		opacity: 0;
		animation: intro-logo-failsafe 0.3s ease-out 4.5s forwards;
	}
	html.intro-live [data-site-header] [data-site-logo] {
		animation: none;
	}
	@keyframes intro-logo-failsafe {
		to {
			opacity: 1;
		}
	}

	/* ---------- Background: navy→blue, a faint drifting grid and a few circuit traces ---------- */
	.intro-bg {
		position: absolute;
		inset: 0;
		background: radial-gradient(120% 90% at 50% 45%, #1e5bb8 0%, #123a7d 38%, #0a1a3a 78%);
	}
	.intro-grid {
		position: absolute;
		inset: -48px;
		background-image:
			linear-gradient(rgb(16 157 192 / 0.13) 1px, transparent 1px),
			linear-gradient(90deg, rgb(16 157 192 / 0.13) 1px, transparent 1px);
		background-size: 48px 48px;
		mask-image: radial-gradient(70% 60% at 50% 48%, #000 20%, transparent 100%);
		animation: intro-grid 7s cubic-bezier(0.37, 0, 0.63, 1) infinite alternate;
		will-change: transform;
	}
	@keyframes intro-grid {
		to {
			transform: translate3d(48px, 24px, 0);
		}
	}
	.intro-trace {
		position: absolute;
		left: -20%;
		top: var(--y);
		width: 18%;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgb(34 211 238 / 0.55), transparent);
		opacity: 0;
		animation: intro-trace-x 3.2s cubic-bezier(0.65, 0, 0.35, 1) var(--d) infinite;
		will-change: transform, opacity;
	}
	.intro-trace--v {
		left: var(--x);
		top: -20%;
		width: 1px;
		height: 18%;
		background: linear-gradient(180deg, transparent, rgb(34 211 238 / 0.5), transparent);
		animation-name: intro-trace-y;
	}
	@keyframes intro-trace-x {
		0% {
			transform: translate3d(0, 0, 0);
			opacity: 0;
		}
		15%,
		75% {
			opacity: 0.8;
		}
		100% {
			transform: translate3d(720%, 0, 0);
			opacity: 0;
		}
	}
	@keyframes intro-trace-y {
		0% {
			transform: translate3d(0, 0, 0);
			opacity: 0;
		}
		15%,
		75% {
			opacity: 0.8;
		}
		100% {
			transform: translate3d(0, 720%, 0);
			opacity: 0;
		}
	}

	/* ---------- Logo ---------- */
	.intro-stage {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		perspective: 900px;
	}
	.intro-logo {
		width: min(760px, 86vw);
		transform-origin: 0 0;
		will-change: transform, opacity;
	}
	.intro-parallax {
		position: relative;
		will-change: transform;
	}
	/* The wrench's own layers (built by the script), stacked exactly over the logo. */
	.jl-wlayer {
		position: absolute;
		inset: 0;
		will-change: transform;
	}
	.intro-logo svg.jl-wrench-svg {
		position: absolute;
		inset: 0;
		height: 100%;
	}
	.intro-logo svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible; /* the wrench flies in from well outside the logo */
	}
	/* Parts start hidden and are brought in by the script. Reduced motion shows the finished logo at once. */
	html.intro:not(.intro-reduced) .jl-part {
		opacity: 0;
	}
	.jl-line,
	.jl-metal,
	#jl-screen-glow,
	#jl-jpl-ink,
	#jl-cursor,
	#jl-sweep {
		opacity: 0;
	}
	.jl-ring,
	.jl-line {
		stroke-dasharray: 1;
	}
	/* Transform origins, in the logo's own pixel coordinates (view-box) or per shape (fill-box). */
	.jl-logo #jl-badge-fill {
		transform-box: view-box;
		transform-origin: 610.9px 163.9px;
	}
	.jl-logo #jl-wrench-y,
	.jl-logo #jl-wrench,
	.jl-logo .jl-wave {
		transform-box: view-box;
		transform-origin: 610.5px 147.5px; /* wrench head centre */
	}
	.jl-logo .jl-letter,
	.jl-logo .jl-stand {
		transform-box: fill-box;
		transform-origin: 50% 100%;
	}
	.jl-logo #jl-sweep {
		transform-box: fill-box;
		transform-origin: 50% 50%;
		transform: skewX(-18deg);
	}

	/* ---------- Skip ---------- */
	.intro-skip {
		position: absolute;
		right: max(1rem, env(safe-area-inset-right));
		bottom: max(1rem, env(safe-area-inset-bottom));
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 44px;
		padding: 0 1rem;
		border: 1px solid rgb(255 255 255 / 0.22);
		border-radius: 999px;
		background: rgb(10 26 58 / 0.35);
		color: rgb(255 255 255 / 0.85);
		font: 600 14px/1 "Archivo Variable", ui-sans-serif, system-ui, sans-serif;
		letter-spacing: 0.02em;
		backdrop-filter: blur(8px);
		cursor: pointer;
		transition:
			background-color 0.2s,
			color 0.2s;
	}
	.intro-skip:hover {
		background: rgb(255 255 255 / 0.12);
		color: #fff;
	}

	@media (prefers-reduced-motion: reduce) {
		.intro-grid,
		.intro-trace {
			animation: none;
		}
		.intro-trace {
			display: none;
		}
	}
	@media (forced-colors: active) {
		html.intro .intro-splash {
			display: none;
		}
		html.intro [data-site-header] [data-site-logo] {
			opacity: 1;
		}
	}
</style>
