---
import { ClientRouter } from "astro:transitions";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import "@/styles/global.css";

interface Props {
	title?: string | undefined;
	description?: string | undefined;
}

const {
	title = "JPL Innovation",
	description = "Student engineers in Ho Chi Minh City building competition robots, a 4G drone, and secure networks.",
} = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#eef1f4" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0b1420" media="(prefers-color-scheme: dark)" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL("/assets/logo.jpg", Astro.site ?? Astro.url)} />
		<title>{title}</title>
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<script is:inline>
			// Inlined and blocking so the page never flashes the wrong theme.
			// `motion` hides scroll-revealed content until src/scripts/motion.ts animates it in.
			// Skipped for reduced motion; removed again if the script hasn't started within 2.5 s.
			const applyMotion = () => {
				const root = document.documentElement;
				if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
				root.classList.add("motion");
				setTimeout(() => {
					if (!root.classList.contains("motion-live")) root.classList.remove("motion");
				}, 2500);
			};
			applyMotion();
			// The only thing this site keeps in localStorage is this theme choice (no tokens, no accounts).
			// Anything other than "dark"/"light" is ignored and the system setting is used instead.
			const applyTheme = () => {
				let stored = null;
				try {
					stored = localStorage.getItem("theme");
				} catch {}
				const valid = stored === "dark" || stored === "light";
				const dark = valid ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
				document.documentElement.classList.toggle("dark", dark);
			};
			applyTheme();
			// Client-side navigation swaps <html> attributes, so re-apply after each swap.
			if (!window.__jplThemeHook) {
				document.addEventListener("astro:after-swap", () => {
					applyTheme();
					applyMotion();
				});
				window.__jplThemeHook = true;
			}
		</script>
		<ClientRouter />
	</head>
	<body>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-foreground"
		>
			Skip to content
		</a>
		<SiteHeader />
		<main id="main" class="flex-1">
			<slot />
		</main>
		<SiteFooter />
		<script>
			import "@/scripts/motion";
		</script>
	</body>
</html>
