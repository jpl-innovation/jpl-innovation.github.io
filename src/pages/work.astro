---
import ContactSection from "@/components/ContactSection.astro";
import PageIntro from "@/components/PageIntro.astro";
import ProjectList from "@/components/ProjectList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProjects } from "@/lib/content";

const projects = await getProjects();
---

<BaseLayout title="Work | JPL Innovation" description="JPL Innovation's projects: FRC Team 10951, the F450 4G drone, and cybersecurity.">
	<PageIntro title="Work" lede="What we've built, what's on the bench now, and what's coming next." />
	<section class="wrapper pb-20 md:pb-28">
		<ProjectList projects={projects} headingLevel="h2" />
	</section>
	<ContactSection />
</BaseLayout>
