---
import JoinBand from "@/components/JoinBand.astro";
import MemberList from "@/components/MemberList.astro";
import ModelViewer from "@/components/model-viewer";
import PageIntro from "@/components/PageIntro.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getMembers, toBadge } from "@/lib/content";

const members = await getMembers();
const badges = members.map(toBadge);
---

<BaseLayout title="Members | JPL Innovation" description="The students behind JPL Innovation.">
	<PageIntro title="Members" lede="The students behind JPL Innovation." />

	<section class="wrapper pb-14 md:pb-20" aria-labelledby="badges-heading">
		<h2 id="badges-heading" class="sr-only">Member badges in 3D</h2>
		<div class="overflow-hidden rounded-xl border bg-card" data-reveal>
			<ModelViewer
				client:visible
				model="badges"
				options={{ members: badges, mode: "row" }}
				label={`3D ID badges for ${members.map((m) => m.data.title).join(" and ")}, hanging on JPL Innovation lanyards.`}
				className="aspect-[4/3] w-full sm:aspect-[16/8]"
			>
				<div class="flex h-full items-center justify-center gap-6 p-8">
					{members.map((m) => <img src={m.data.img} alt="" class="h-3/4 w-auto rounded-xl object-cover shadow-sm" loading="lazy" />)}
				</div>
			</ModelViewer>
		</div>
		<p class="mt-3 text-sm text-muted-foreground">Point at a badge to turn it toward you; click to open that member.</p>
	</section>

	<section class="wrapper pb-20 md:pb-28">
		<MemberList members={members} headingLevel="h2" />
	</section>
	<JoinBand />
</BaseLayout>
