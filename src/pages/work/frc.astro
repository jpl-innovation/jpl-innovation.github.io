---
import { getEntry } from "astro:content";
import BackLink from "@/components/BackLink.astro";
import FrcRobotReveal from "@/components/frc-robot-reveal";
import FrcSeasons from "@/components/frc-seasons";
import HardwareStack from "@/components/HardwareStack.astro";
import JoinBand from "@/components/JoinBand.astro";
import ModelViewer from "@/components/model-viewer";
import Odometer from "@/components/Odometer.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { team } from "@/data/frc";
import { DataIcon } from "@/lib/icons";

// Title, image and description for the project card live in src/content/work/frc.md;
// season content lives in src/data/frc.ts.
const entry = (await getEntry("work", "frc"))!;

const facts = [
	{ label: "Rookie year", value: String(team.rookieYear) },
	{ label: "Region", value: team.region },
	{ label: "Home", value: "SSIS, Ho Chi Minh City" },
	{ label: "Next season", value: "2027" },
];
---

<BaseLayout title="FIRST Robotics | JPL Innovation" description={entry.data.description}>
	<div class="wrapper pt-6 md:pt-8">
		<BackLink href="/work/">All work</BackLink>
	</div>

	<header class="wrapper flex flex-col items-center gap-6 pb-14 pt-6 text-center md:pb-20 md:pt-10">
		<div class="flex flex-col items-center gap-3" data-reveal>
			<div class="flex items-center gap-4 md:gap-5">
				<!-- Team 10951 logo. The source image has photo corners, so it's cropped to its circle. -->
				<img
					src={team.logo}
					alt="Team 10951 Saigon South Dragons logo"
					width="764"
					height="764"
					class="size-14 rounded-full object-cover shadow-sm ring-1 ring-border md:size-16"
				/>
				<span class="h-10 w-px bg-border" aria-hidden="true"></span>
				<!-- The FIRST logo file is white on black: screen-blend drops the black in dark mode;
				     in light mode it's inverted to black on white and multiply-blended. -->
				<img
					src="/assets/FRC_logo.png"
					alt="FIRST"
					width="438"
					height="115"
					class="h-10 w-auto invert mix-blend-multiply md:h-12 dark:invert-0 dark:mix-blend-screen"
				/>
			</div>
			<p class="text-[15px] font-medium text-muted-foreground">Saigon South Dragons · FIRST Robotics Competition</p>
		</div>
		<h1 class="font-wide text-[clamp(3.25rem,12vw,10.5rem)] font-[900] leading-[0.9] tracking-[-0.03em]">
			Team <Odometer value={String(team.number)} />
		</h1>
		<p class="max-w-[56ch] text-lg text-muted-foreground md:text-xl" data-reveal data-reveal-delay="250">
			{entry.data.description}
		</p>
		<dl class="mt-4 grid w-full max-w-3xl grid-cols-2 gap-x-6 gap-y-5 border-t pt-6 sm:grid-cols-4" data-reveal-group>
			{
				facts.map((f) => (
					<div class="flex flex-col gap-0.5">
						<dt class="text-sm text-muted-foreground">{f.label}</dt>
						<dd class="font-semibold">{f.value}</dd>
					</div>
				))
			}
		</dl>
	</header>

	<FrcRobotReveal client:load src={entry.data.img} alt={entry.data.img_alt ?? ""} />

	<section class="wrapper pt-20 md:pt-28" aria-labelledby="robot-3d-heading">
		<div class="grid items-center gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">
			<div class="flex flex-col gap-4" data-reveal>
				<h2 id="robot-3d-heading" class="font-wide text-3xl font-[850] md:text-5xl">The 2026 robot in 3D</h2>
				<p class="text-lg text-muted-foreground">
					Our modified KitBot, rebuilt from photos of the front and back. Follow a game piece from the intake, up and
					over the rollers along the arc guides, and into the clear hopper. On a computer you can drag to look around.
				</p>
				<p class="text-sm text-muted-foreground">A simplified model for illustration, not our CAD.</p>
			</div>
			<div class="overflow-hidden rounded-xl border bg-card" data-reveal data-reveal-delay="150">
				<ModelViewer
					client:visible
					model="frc-robot"
					label="3D model of Team 10951's 2026 modified KitBot: aluminium frame, red star-wheel intake, white, blue and black arc guides over a banded roller, Kraken X60 motors, a Limelight camera, a red signal light and a clear rear hopper with the 10951 Saigon South Dragons decal."
					className="aspect-[4/3] w-full"
				>
					<img src="/assets/FRCnew.jpg" alt="Team 10951's 2026 robot" class="size-full object-cover object-[32%_68%]" loading="lazy" />
				</ModelViewer>
			</div>
		</div>
	</section>

	<div class="wrapper py-24 md:py-32">
		<!-- Hydrates once the page is idle: it's below the fold, and #2026 deep links still work. -->
		<FrcSeasons client:idle />
	</div>

	<HardwareStack />

	<section class="border-t bg-card" aria-labelledby="team-heading">
		<div class="wrapper flex flex-col gap-8 py-20 md:py-24">
			<div class="flex max-w-2xl items-center gap-5" data-reveal>
				<img
					src={team.logo}
					alt=""
					width="764"
					height="764"
					loading="lazy"
					class="size-16 shrink-0 rounded-full object-cover ring-1 ring-border md:size-20"
				/>
				<div class="flex flex-col gap-2">
					<h2 id="team-heading" class="font-wide text-3xl font-[850] md:text-4xl">About Team {team.number}</h2>
					<p class="text-lg text-muted-foreground">{team.name}, {team.school}. {team.mission}.</p>
				</div>
			</div>
			<ul class="grid gap-x-8 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
				{
					team.focus.map((f) => (
						<li class="flex flex-col gap-2 border-t py-6">
							<DataIcon name={f.icon} className="size-6" strokeWidth={1.75} />
							<h3 class="font-semiwide text-lg font-[760]">{f.title}</h3>
							<p class="text-muted-foreground">{f.desc}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<JoinBand />
</BaseLayout>
