---
import { getEntry } from "astro:content";
import CallToAction from "../../components/CallToAction.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import Icon from "../../components/Icon.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { season2026, season2027, team } from "../../data/frc";

// Card title/description/image still come from src/content/work/frc.md.
const entry = (await getEntry("work", "frc"))!;

const { game, robot } = season2026;
const matchSeconds = game.phases.reduce((sum, p) => sum + p.seconds, 0);
const maxPoints = Math.max(...game.scoring.map((s) => s.max));

const sections2026 = [
	{ id: "s2026-game", label: "Game" },
	{ id: "s2026-timeline", label: "Timeline" },
	{ id: "s2026-robot", label: "Robot" },
	{ id: "s2026-results", label: "Results" },
];
---

<BaseLayout title="FIRST Robotics | JPL Innovation" description={entry.data.description}>
	<div class="stack gap-20">
		<main class="frc stack gap-15">
			<!-- ============ Hero ============ -->
			<header class="wrapper hero">
				<a class="back-link" href="/work/"><Icon icon="arrow-left" /> All work</a>

				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">
							<span class="pulse" aria-hidden="true"></span>
							FIRST Robotics Competition
						</p>
						<h1>Team <span class="gradient-text">{team.number}</span></h1>
						<p class="lede">{entry.data.description}</p>

						<dl class="facts">
							<div>
								<dt><Icon icon="rocket-launch" /> Rookie year</dt>
								<dd>{team.rookieYear}</dd>
							</div>
							<div>
								<dt><Icon icon="map-pin" /> Region</dt>
								<dd>{team.region}</dd>
							</div>
							<div>
								<dt><Icon icon="users" /> Home</dt>
								<dd>SSIS</dd>
							</div>
							<div>
								<dt><Icon icon="sparkle" /> Next season</dt>
								<dd>{season2027.year}</dd>
							</div>
						</dl>
					</div>

					<figure class="hero-photo">
						<img
							src={entry.data.img}
							alt={entry.data.img_alt || ""}
							width="2000"
							height="1333"
							fetchpriority="high"
						/>
						<span class="corner tl" aria-hidden="true"></span>
						<span class="corner br" aria-hidden="true"></span>
						<figcaption>2026 robot · practice field</figcaption>
					</figure>
				</div>
			</header>

			<!-- ============ Season switcher ============ -->
			<div class="wrapper switch-wrap">
				<div class="season-switch" role="tablist" aria-label="Choose a season">
					<button
						class="season-tab"
						role="tab"
						id="tab-2027"
						aria-controls="season-2027"
						aria-selected="true"
						data-season-tab="2027"
					>
						<span class="tab-year">2027</span>
						<span class="tab-tag soon">{season2027.status}</span>
					</button>
					<button
						class="season-tab"
						role="tab"
						id="tab-2026"
						aria-controls="season-2026"
						aria-selected="false"
						data-season-tab="2026"
					>
						<span class="tab-year">2026</span>
						<span class="tab-tag">{season2026.status}</span>
					</button>
				</div>
			</div>

			<!-- ============ 2027 ============ -->
			<section id="season-2027" class="season wrapper stack gap-15" role="tabpanel" aria-labelledby="tab-2027">
				<div class="soon-card" data-reveal>
					<div class="soon-copy">
						<p class="status-chip">
							<span class="pulse" aria-hidden="true"></span>
							Preseason in progress
						</p>
						<h2>{season2027.headline}</h2>
						<p>{season2027.intro}</p>
						<div class="soon-actions">
							<CallToAction href="mailto:antruongphs2@gmail.com?subject=FRC%202027">
								Join or sponsor us
								<Icon icon="paper-plane-tilt" size="1.1em" />
							</CallToAction>
							<button class="text-button" type="button" data-show-season="2026">
								Relive 2026 <Icon icon="arrow-right" />
							</button>
						</div>
					</div>
					<div class="big-year" aria-hidden="true">
						<span>20</span><span>27</span>
					</div>
				</div>

				<div class="block stack gap-8">
					<header class="block-header" data-reveal>
						<p class="kicker">Road to 2027</p>
						<h2>Season roadmap</h2>
					</header>
					<ol class="roadmap">
						{
							season2027.timeline.map((step, i) => (
								<li
									class:list={["roadmap-step", step.state]}
									data-reveal
									style={`--reveal-delay: ${i * 100}ms`}
								>
									<span class="step-dot" aria-hidden="true" />
									<p class="step-when">
										{step.when}
										{step.state === "current" && <span class="now">Now</span>}
									</p>
									<h3>{step.title}</h3>
									<p class="step-desc">{step.desc}</p>
								</li>
							))
						}
					</ol>
				</div>

				<div class="block stack gap-8">
					<header class="block-header" data-reveal>
						<p class="kicker">Lessons from our rookie year</p>
						<h2>What we're building toward</h2>
					</header>
					<ul class="card-grid three">
						{
							season2027.focus.map((f, i) => (
								<li class="feature surface" data-reveal style={`--reveal-delay: ${(i % 3) * 100}ms`}>
									<span class="feature-icon">
										<Icon icon={f.icon} size="1.5rem" />
									</span>
									<h3>{f.title}</h3>
									<p>{f.desc}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<!-- ============ 2026 ============ -->
			<section id="season-2026" class="season wrapper stack gap-15" role="tabpanel" aria-labelledby="tab-2026" hidden>
				<noscript><style>#season-2026 { display: flex !important; }</style></noscript>
				<nav class="subnav" aria-label="2026 season sections">
					{sections2026.map((s, i) => (
						<a href={`#${s.id}`}>
							<span class="num">0{i + 1}</span>
							{s.label}
						</a>
					))}
				</nav>

				<!-- 01 Game -->
				<div class="block stack gap-8" id="s2026-game">
					<header class="block-header" data-reveal>
						<p class="kicker"><span class="num">01</span> Game overview</p>
						<h2>Precision scoring</h2>
					</header>

					<div class="game-intro" data-reveal>
						<div class="stack gap-4">
							<p class="big-text">{game.summary}</p>
							<p class="meta"><Icon icon="calendar" /> Competition season: {game.season}</p>
						</div>
						<img
							class="field-img"
							src={game.fieldImage}
							alt="Official 2026 FRC playing field layout"
							loading="lazy"
						/>
					</div>

					<div class="match surface" data-reveal>
						<div class="match-head">
							<h3><Icon icon="clock" /> Match structure</h3>
							<p>2:30 per match</p>
						</div>
						<div class="match-bar" aria-hidden="true">
							{
								game.phases.map((p, i) => (
									<span class={`phase-seg seg-${i}`} style={`flex-grow: ${p.seconds}`}>
										{p.time}
									</span>
								))
							}
						</div>
						<ol class="phases">
							{
								game.phases.map((p, i) => (
									<li>
										<span class={`phase-key seg-${i}`} aria-hidden="true" />
										<div>
											<h4>
												{p.name} <span class="phase-time">{p.time}</span>
											</h4>
											<p>{p.desc}</p>
										</div>
									</li>
								))
							}
						</ol>
						<p class="sr-only">
							Total match length {matchSeconds} seconds.
						</p>
					</div>

					<div class="scoring surface" data-reveal>
						<h3><Icon icon="target" /> Scoring breakdown</h3>
						<ul class="score-list">
							{
								game.scoring.map((s) => (
									<li>
										<span class="score-name">
											{s.method}
											<small>{s.note}</small>
										</span>
										<span class="score-bar" aria-hidden="true">
											<span style={`--w: ${(s.max / maxPoints) * 100}%`} />
										</span>
										<span class="score-pts">{s.points}</span>
									</li>
								))
							}
						</ul>
						<p class="meta"><Icon icon="trophy" /> {game.rankingPoints}</p>
					</div>
				</div>

				<!-- 02 Timeline -->
				<div class="block stack gap-8" id="s2026-timeline">
					<header class="block-header" data-reveal>
						<p class="kicker"><span class="num">02</span> Season timeline</p>
						<h2>From kickoff to competition</h2>
					</header>
					<ol class="vtimeline">
						{
							season2026.timeline.map((t) => (
								<li data-reveal>
									<span class="v-dot" aria-hidden="true" />
									<p class="v-when">{t.when}</p>
									<div class="v-body">
										<h3>{t.title}</h3>
										<p>{t.desc}</p>
									</div>
								</li>
							))
						}
					</ol>
				</div>

				<!-- 03 Robot -->
				<div class="block stack gap-8" id="s2026-robot">
					<header class="block-header" data-reveal>
						<p class="kicker"><span class="num">03</span> The robot</p>
						<h2>Built for reliability</h2>
					</header>

					<blockquote class="philosophy" data-reveal>
						<Icon icon="sparkle" size="1.5rem" />
						<p>{robot.philosophy}</p>
					</blockquote>

					<ul class="stats" data-reveal>
						{
							robot.stats.map((s) => (
								<li class="stat surface">
									<span class="stat-value">
										<span data-count={s.value}>{s.value}</span>
										<small>{s.suffix}</small>
									</span>
									<span class="stat-label">{s.label}</span>
								</li>
							))
						}
					</ul>

					<ul class="card-grid two">
						{
							robot.specs.map((spec, i) => (
								<li class="spec surface" data-reveal style={`--reveal-delay: ${(i % 2) * 100}ms`}>
									<h3>
										<span class="feature-icon">
											<Icon icon={spec.icon} size="1.25rem" />
										</span>
										{spec.title}
									</h3>
									<ul>
										{spec.items.map((item) => (
											<li>{item}</li>
										))}
									</ul>
								</li>
							))
						}
					</ul>

					<div class="metrics surface" data-reveal>
						<h3><Icon icon="check-circle" /> Performance in testing</h3>
						<ul>
							{
								robot.metrics.map((m) => (
									<li>
										<div class="metric-head">
											<span>
												{m.label} <small>{m.detail}</small>
											</span>
											<strong>
												<span data-count={m.value}>{m.value}</span>%
											</strong>
										</div>
										<span
											class="meter"
											role="meter"
											aria-valuenow={m.value}
											aria-valuemin="0"
											aria-valuemax="100"
											aria-label={m.label}
										>
											<span class="meter-fill" style={`--v: ${m.value}`} />
										</span>
									</li>
								))
							}
						</ul>
					</div>
				</div>

				<!-- 04 Results -->
				<div class="block stack gap-8" id="s2026-results">
					<header class="block-header" data-reveal>
						<p class="kicker"><span class="num">04</span> Results & goals</p>
						<h2>What our rookie season delivered</h2>
					</header>

					<ul class="card-grid four">
						{
							season2026.achievements.map((a, i) => (
								<li class="feature surface" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
									<span class="feature-icon">
										<Icon icon="trophy" size="1.25rem" />
									</span>
									<h3>{a.title}</h3>
									<p>{a.desc}</p>
								</li>
							))
						}
					</ul>

					<ul class="card-grid two">
						{
							season2026.competitions.map((c, i) => (
								<li class="event surface" data-reveal style={`--reveal-delay: ${i * 100}ms`}>
									<span class="event-code" aria-hidden="true">{c.code}</span>
									<div class="stack gap-2">
										<h3>{c.name}</h3>
										<p class="meta"><Icon icon="calendar" /> {c.dates}</p>
										<p class="meta"><Icon icon="map-pin" /> {c.city}</p>
										<ul class="checks">
											{c.goals.map((g) => (
												<li>{g}</li>
											))}
										</ul>
									</div>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<!-- ============ Team (both seasons) ============ -->
			<section class="wrapper block stack gap-8">
				<header class="block-header" data-reveal>
					<p class="kicker">About us</p>
					<h2>Team {team.number}</h2>
					<p class="block-sub">{team.school} · {team.mission}</p>
				</header>
				<ul class="card-grid four">
					{
						team.focus.map((f, i) => (
							<li class="feature surface" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
								<span class="feature-icon">
									<Icon icon={f.icon} size="1.25rem" />
								</span>
								<h3>{f.title}</h3>
								<p>{f.desc}</p>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>

<script>
	/** Season tabs: click, arrow keys, and #2026 / #2027 deep links. */
	function initSeasons() {
		const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-season-tab]")];
		if (!tabs.length) return;
		const switcher = tabs[0].parentElement!;
		const panels = tabs.map((t) => document.getElementById(t.getAttribute("aria-controls")!)!);

		const select = (index: number, { focus = false, updateHash = true } = {}) => {
			tabs.forEach((tab, i) => {
				const active = i === index;
				tab.setAttribute("aria-selected", String(active));
				tab.tabIndex = active ? 0 : -1;
				panels[i].hidden = !active;
			});
			switcher.style.setProperty("--active", String(index));
			if (focus) tabs[index].focus();
			if (updateHash) history.replaceState(null, "", `#${tabs[index].dataset.seasonTab}`);
		};

		tabs.forEach((tab, i) => {
			tab.addEventListener("click", () => select(i));
			tab.addEventListener("keydown", (e) => {
				if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
				e.preventDefault();
				const next = (i + (e.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
				select(next, { focus: true });
			});
		});

		// Buttons elsewhere on the page that jump to a season.
		document.querySelectorAll<HTMLElement>("[data-show-season]").forEach((btn) => {
			btn.addEventListener("click", () => {
				const i = tabs.findIndex((t) => t.dataset.seasonTab === btn.dataset.showSeason);
				if (i < 0) return;
				select(i);
				switcher.parentElement!.scrollIntoView({ behavior: "smooth", block: "start" });
			});
		});

		// Pick the initial tab from the URL hash (#2026, or a 2026 section like #s2026-robot).
		const hash = location.hash.slice(1);
		const initial = tabs.findIndex((t) => hash === t.dataset.seasonTab || hash.startsWith(`s${t.dataset.seasonTab}`));
		select(Math.max(initial, 0), { updateHash: false });
		if (hash.startsWith("s")) document.getElementById(hash)?.scrollIntoView();
	}

	/** Count numbers up from zero the first time they scroll into view. */
	function initCounters() {
		if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
		const counters = document.querySelectorAll<HTMLElement>("[data-count]");
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					observer.unobserve(entry.target);
					const el = entry.target as HTMLElement;
					const target = Number(el.dataset.count);
					const decimals = String(el.dataset.count).split(".")[1]?.length ?? 0;
					const start = performance.now();
					const duration = 1200;
					const tick = (now: number) => {
						const t = Math.min((now - start) / duration, 1);
						const eased = 1 - Math.pow(1 - t, 3);
						el.textContent = (target * eased).toFixed(decimals);
						if (t < 1) requestAnimationFrame(tick);
					};
					requestAnimationFrame(tick);
				}
			},
			{ threshold: 0.5 },
		);
		counters.forEach((el) => observer.observe(el));
	}

	document.addEventListener("astro:page-load", () => {
		initSeasons();
		initCounters();
	});
</script>

<style>
	.frc {
		--grid-line: color-mix(in srgb, var(--accent-light) 12%, transparent);
		--seg-0: #9378ca;
		--seg-1: var(--accent-regular);
		--seg-2: var(--accent-light);
	}

	/* ---------- Shared bits ---------- */

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		width: fit-content;
		font-size: var(--text-sm);
		color: var(--link-color);
		text-decoration: none;
		transition: translate var(--ease-duration) var(--ease-out);
	}

	.back-link:hover {
		translate: -4px 0;
	}

	.eyebrow,
	.status-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		width: fit-content;
		padding: 0.35rem 0.9rem;
		border-radius: 999rem;
		border: 1px solid var(--border-accent);
		background: var(--accent-overlay);
		color: var(--gray-100);
		font-size: var(--text-sm);
		font-weight: 700;
	}

	.pulse {
		position: relative;
		flex-shrink: 0;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--accent-light);
	}

	.pulse::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: inherit;
		animation: ping 2s var(--ease-out) infinite;
	}

	@keyframes ping {
		75%,
		100% {
			transform: scale(2.6);
			opacity: 0;
		}
	}

	.gradient-text {
		background: linear-gradient(120deg, var(--accent-light), #9378ca 60%, var(--accent-light));
		background-size: 200% auto;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		animation: shimmer 6s linear infinite;
	}

	@keyframes shimmer {
		to {
			background-position: 200% center;
		}
	}

	.meta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: var(--text-sm);
		color: var(--gray-400);
	}

	.num {
		font-variant-numeric: tabular-nums;
		color: var(--link-color);
		font-weight: 700;
	}

	.kicker {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gray-400);
	}

	.block-header h2 {
		font-size: var(--text-2xl);
		color: var(--gray-0);
	}

	.block-sub {
		color: var(--gray-400);
	}

	.block-header {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.block {
		scroll-margin-top: 7rem;
	}

	h3 {
		font-size: var(--text-lg);
		color: var(--gray-100);
	}

	.surface {
		border-radius: 1.25rem;
	}

	.feature-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.8rem;
		color: var(--link-color);
		background: var(--accent-overlay);
		border: 1px solid var(--border-accent);
	}

	.card-grid {
		display: grid;
		gap: 1.25rem;
		list-style: none;
		padding: 0;
	}

	/* ---------- Hero ---------- */

	.hero {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.hero-grid {
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}

	.hero-copy {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		animation: rise 900ms var(--ease-out) both;
	}

	.hero-copy h1 {
		font-size: var(--text-4xl);
		color: var(--gray-0);
	}

	.lede {
		font-size: var(--text-md);
		color: var(--gray-300);
		max-width: 55ch;
	}

	.facts {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.75rem;
		margin-top: 0.5rem;
	}

	.facts div {
		padding: 0.9rem 1rem;
		border-radius: 1rem;
		border: 1px solid var(--border-subtle);
		background: var(--surface-bg);
	}

	.facts dt {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--text-sm);
		color: var(--gray-400);
	}

	.facts dd {
		margin: 0.25rem 0 0;
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 600;
		color: var(--gray-0);
	}

	.hero-photo {
		position: relative;
		animation: rise 1100ms 120ms var(--ease-out) both;
	}

	.hero-photo img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
