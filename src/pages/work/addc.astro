---
/**
 * /work/addc/: the website sheet. The page opens with the before-and-after (ADDC's old first screen against the new
 * one, with a divider to drag), then the case, the measured numbers, one of the site's own 3D models to turn, the new
 * site's screens as whole plates, and the write-up from src/text/projects/addc.md, section by section.
 * Words: src/text/projects/addc.md, addc.ts and the addc entry of hooks.ts.
 */
import { getEntry } from "astro:content";
import BackLink from "@/components/BackLink.astro";
import ChapterBackdrop from "@/components/ChapterBackdrop.astro";
import ModelViewer from "@/components/model-viewer";
import NextChapter from "@/components/NextChapter.astro";
import Odometer from "@/components/Odometer.astro";
import PageIntro from "@/components/PageIntro.astro";
import ProjectCase from "@/components/ProjectCase.astro";
import TitleBlock from "@/components/TitleBlock.astro";
import AddcCompare from "@/components/work/AddcCompare.astro";
import Plate from "@/components/work/Plate.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { addcPage as text } from "@/text/projects/addc";
import { backToWork } from "@/text/work";

const entry = (await getEntry("work", "addc"))!;
const { data } = entry;
const unescape = (s: string) => s.replace(/&quot;/g, '"').replace(/&#x27;|&#39;/g, "'").replace(/&amp;/g, "&").replace(/&lt;/g, "<").replace(/&gt;/g, ">");

// The write-up, cut at its headings: each section keeps the markdown's own HTML; its pictures come out as plates.
const sections = (entry.rendered?.html ?? "")
	.split(/(?=<h2[\s>])/)
	.filter((chunk) => chunk.startsWith("<h2"))
	.map((chunk) => {
		const head = chunk.match(/^<h2([^>]*)>([\s\S]*?)<\/h2>/)!;
		const id = head[1].match(/id="([^"]*)"/)?.[1] ?? "";
		const plates: Array<{ src: string; alt: string }> = [];
		const body = chunk
			.slice(head[0].length)
			.replace(/<p>\s*(<img[^>]*>)\s*<\/p>/g, (_, img: string) => {
				plates.push({ src: img.match(/src="([^"]*)"/)?.[1] ?? "", alt: unescape(img.match(/alt="([^"]*)"/)?.[1] ?? "") });
				return "";
			})
			.replace(/(<li><strong>[\s\S]*?<\/strong>):\s*/g, '$1<span class="sr-only">: </span>');
		return { id, title: head[2], body, plates };
	});
const small = (src: string) => src.replace(/\.webp$/, "-800.webp");
---

<BaseLayout title={`${data.title} | JPL Innovation`} description={data.description}>
	<ChapterBackdrop project="addc" />
	<PageIntro title={data.title} lede={data.description}>
		<BackLink slot="before" href="/work/">{backToWork}</BackLink>
		<TitleBlock rows={text.titleBlock.rows} label={text.titleBlock.label} class="ad-titleblock" />
	</PageIntro>

	<AddcCompare />

	<ProjectCase project="addc" />

	<section class="wrapper ad-numbers" aria-labelledby="ad-num-heading">
		<h2 id="ad-num-heading" class="ad-sec-h">{text.numbers.heading}</h2>
		<ul class="ad-num-grid">
			{
				text.numbers.items.map((n) => (
					<li class="ad-num">
						<p class="ad-num-value">
							<Odometer value={n.value} />
						</p>
						<p class="ad-num-label">
							{n.label}
							{n.was && (
								<span class="ad-num-was">
									{text.numbers.was} {n.was}
								</span>
							)}
						</p>
						<p class="ad-num-note">{n.note}</p>
					</li>
				))
			}
		</ul>
		<p class="ad-method">{text.numbers.method}</p>
	</section>

	<section class="ad-model" aria-labelledby="ad-model-heading">
		<div class="wrapper ad-head">
			<h2 id="ad-model-heading" class="ad-sec-h">{text.model.heading}</h2>
			<p class="ad-lead">{text.model.intro}</p>
		</div>
		<Plate ratio="16/9">
			<ModelViewer client:visible model="addc-table" label={text.model.label} className="size-full">
				<img src="/work/addc/room-800.webp" alt={text.model.fallback} class="size-full object-cover" loading="lazy" decoding="async" />
			</ModelViewer>
		</Plate>
	</section>

	<section class="ad-screens" aria-labelledby="ad-screens-heading">
		<div class="wrapper ad-head">
			<h2 id="ad-screens-heading" class="ad-sec-h">{text.plates.heading}</h2>
			<p class="ad-lead">{text.plates.intro}</p>
		</div>
		{
			text.plates.items.map((p) => (
				<Plate src={p.src} alt={p.alt} srcset={`${small(p.src)} 800w, ${p.src} 1440w`} sizes="100vw" ratio="16/10" caption={p.alt} />
			))
		}
	</section>

	{
		sections.map((s) => (
			<>
				<section class="wrapper ad-sec" aria-labelledby={s.id}>
					<h2 id={s.id} class="ad-sec-h" set:html={s.title} />
					<div class="ad-text" set:html={s.body} />
				</section>
				{s.plates.map((p) => (
					<Plate src={p.src} alt={p.alt} srcset={`${small(p.src)} 800w, ${p.src} 1440w`} sizes="100vw" ratio="16/10" caption={p.alt} />
				))}
			</>
		))
	}

	<NextChapter current="addc" />
</BaseLayout>

<style>
	:global(dl.title-block.ad-titleblock) {
		margin-top: 1rem;
		max-width: 64rem;
	}
	@media (min-width: 768px) {
		:global(dl.title-block.ad-titleblock) {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
	.ad-sec-h {
		font-size: clamp(1.9rem, 1.2rem + 2.4vw, 3.4rem);
		font-weight: 850;
		font-stretch: 116%;
		line-height: 1;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}
	.ad-head {
		display: grid;
		gap: 0.75rem;
		margin-bottom: 2rem;
	}
	.ad-lead {
		font-size: var(--step-lead);
		color: var(--ink-soft);
		max-width: 46ch;
		text-wrap: pretty;
	}

	/* The numbers: one large figure each, what it measures, and what it was before. */
	.ad-numbers {
		padding-block: clamp(3rem, 8dvh, 6rem);
	}
	.ad-num-grid {
		display: grid;
		gap: 2.5rem 3rem;
		margin: 2.25rem 0 0;
		padding: 0;
		list-style: none;
	}
	@media (min-width: 720px) {
		.ad-num-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 1100px) {
		.ad-num-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
	.ad-num {
		display: grid;
		align-content: start;
		gap: 0.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--sheet-edge);
	}
	.ad-num-value {
		font-size: clamp(2.6rem, 1.6rem + 2.6vw, 4.4rem);
		font-weight: 850;
		font-stretch: 116%;
		line-height: 1;
		font-variant-numeric: tabular-nums;
	}
	.ad-num-label {
		font-weight: 700;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 0.75rem;
	}
	.ad-num-was {
		font-weight: 500;
		color: var(--ink-soft);
		text-decoration: line-through;
		text-decoration-thickness: 1px;
	}
	.ad-num-note {
		color: var(--ink-soft);
		text-wrap: pretty;
	}
	.ad-method {
		margin-top: 2.5rem;
		max-width: 80ch;
		font-size: 0.9rem;
		color: var(--ink-soft);
		text-wrap: pretty;
	}

	.ad-model,
	.ad-screens {
		padding-block: clamp(3rem, 8dvh, 6rem) 0;
	}

	/* The write-up: the heading on the left, the words on the right, ruled like a drawing's notes. */
	.ad-sec {
		display: grid;
		gap: 1.25rem 4rem;
		padding-block: clamp(3rem, 7dvh, 5.5rem) clamp(1.5rem, 3dvh, 2.5rem);
	}
	@media (min-width: 1024px) {
		.ad-sec {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			align-items: start;
		}
		.ad-sec .ad-sec-h {
			position: sticky;
			top: 6.5rem;
			font-size: clamp(1.75rem, 1rem + 1.7vw, 2.6rem);
			line-height: 1.04;
		}
	}
	.ad-text {
		font-size: var(--step-body);
		line-height: 1.6;
		max-width: 64ch;
	}
	.ad-text :global(p + p) {
		margin-top: 1em;
	}
	.ad-text :global(ul) {
		list-style: none;
		margin: 1em 0 0;
		padding: 0;
		border-top: 1px solid var(--sheet-edge);
	}
	.ad-text :global(li) {
		padding: 0.85em 0;
		border-bottom: 1px solid var(--sheet-edge);
		text-wrap: pretty;
	}
	.ad-text :global(strong) {
		display: block;
		font-weight: 700;
	}
</style>
