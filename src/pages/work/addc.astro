---
/**
 * /work/addc/: the website sheet. The page opens with the before-and-after (ADDC's old first screen against the new
 * one, with a divider to drag), then the old site against the new point by point (the same part of both, in words with
 * a picture of each), the measured numbers, one of the site's own 3D models to turn, and the write-up from
 * src/text/projects/addc.md. Words: src/text/projects/addc.md and addc.ts. Pictures of both sites: public/work/addc/vs/.
 */
import { getEntry } from "astro:content";
import BackLink from "@/components/BackLink.astro";
import ChapterBackdrop from "@/components/ChapterBackdrop.astro";
import ModelViewer from "@/components/model-viewer";
import NextChapter from "@/components/NextChapter.astro";
import Odometer from "@/components/Odometer.astro";
import PageIntro from "@/components/PageIntro.astro";
import TitleBlock from "@/components/TitleBlock.astro";
import AddcCompare from "@/components/work/AddcCompare.astro";
import Plate from "@/components/work/Plate.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { addcPage as text } from "@/text/projects/addc";
import { backToWork } from "@/text/work";

const entry = (await getEntry("work", "addc"))!;
const { data } = entry;

// The write-up, cut at its headings.
const sections = (entry.rendered?.html ?? "")
	.split(/(?=<h2[\s>])/)
	.filter((chunk) => chunk.startsWith("<h2"))
	.map((chunk) => {
		const head = chunk.match(/^<h2([^>]*)>([\s\S]*?)<\/h2>/)!;
		const id = head[1].match(/id="([^"]*)"/)?.[1] ?? "";
		const body = chunk.slice(head[0].length).replace(/(<li><strong>[\s\S]*?<\/strong>):\s*/g, '$1<span class="sr-only">: </span>');
		return { id, title: head[2], body };
	});
const small = (src: string) => src.replace(/\.webp$/, "-800.webp");
const sides = (row: (typeof text.versus.rows)[number]) => [
	{ key: "old", label: text.versus.before, ...row.old },
	{ key: "new", label: text.versus.after, ...row.new },
];
---

<BaseLayout title={`${data.title} | JPL Innovation`} description={data.description}>
	<ChapterBackdrop project="addc" />
	<PageIntro title={data.title} lede={data.description}>
		<BackLink slot="before" href="/work/">{backToWork}</BackLink>
		<TitleBlock rows={text.titleBlock.rows} label={text.titleBlock.label} class="ad-titleblock" />
	</PageIntro>

	<AddcCompare />

	<section class="wrapper ad-vs" aria-labelledby="ad-vs-heading">
		<div class="ad-head">
			<h2 id="ad-vs-heading" class="ad-sec-h">{text.versus.heading}</h2>
			<p class="ad-lead">{text.versus.intro}</p>
		</div>
		<ol class="ad-vs-list">
			{
				text.versus.rows.map((row, i) => (
					<li class="ad-row" aria-labelledby={`vs-${row.id}`}>
						<h3 id={`vs-${row.id}`} class="ad-row-h">
							<span class="ad-row-n" aria-hidden="true">
								{String(i + 1).padStart(2, "0")}
							</span>
							{row.topic}
						</h3>
						<div class="ad-row-pair">
							{sides(row).map((side) => (
								<figure class:list={["ad-side", `ad-side--${side.key}`]}>
									<p class="ad-side-label">{side.label}</p>
									<a class="ad-side-shot" href={side.img} data-zoom-alt={side.alt}>
										<img src={side.img} srcset={`${small(side.img)} 800w, ${side.img} 1200w`} sizes="(min-width: 900px) 45vw, 100vw" alt={side.alt} width="1200" height="750" loading="lazy" decoding="async" />
									</a>
									<figcaption class="ad-side-text">{side.text}</figcaption>
								</figure>
							))}
						</div>
						<p class="ad-row-changed">
							<strong>{text.versus.changed}</strong> {row.changed}
						</p>
					</li>
				))
			}
		</ol>
	</section>

	<section class="wrapper ad-numbers" aria-labelledby="ad-num-heading">
		<h2 id="ad-num-heading" class="ad-sec-h">{text.numbers.heading}</h2>
		<ul class="ad-num-grid">
			{
				text.numbers.items.map((n) => (
					<li class="ad-num">
						<p class="ad-num-value">
							<Odometer value={n.value} />
						</p>
						<p class="ad-num-label">
							{n.label}
							{n.was && (
								<span class="ad-num-was">
									{text.numbers.was} {n.was}
								</span>
							)}
						</p>
						<p class="ad-num-note">{n.note}</p>
					</li>
				))
			}
		</ul>
		<p class="ad-method">{text.numbers.method}</p>
	</section>

	<section class="ad-model" aria-labelledby="ad-model-heading">
		<div class="wrapper ad-head">
			<h2 id="ad-model-heading" class="ad-sec-h">{text.model.heading}</h2>
			<p class="ad-lead">{text.model.intro}</p>
		</div>
		<Plate ratio="16/9">
			<ModelViewer client:visible model="addc-table" label={text.model.label} className="size-full">
				<img src="/work/addc/room-800.webp" alt={text.model.fallback} class="size-full object-cover" loading="lazy" decoding="async" />
			</ModelViewer>
		</Plate>
	</section>

	{
		sections.map((s) => (
			<section class="wrapper ad-sec" aria-labelledby={s.id}>
				<h2 id={s.id} class="ad-sec-h" set:html={s.title} />
				<div class="ad-text" set:html={s.body} />
			</section>
		))
	}

	<NextChapter current="addc" />
</BaseLayout>

<style>
	:global(dl.title-block.ad-titleblock) {
		margin-top: 1rem;
		max-width: 64rem;
	}
	@media (min-width: 768px) {
		:global(dl.title-block.ad-titleblock) {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
	.ad-sec-h {
		font-size: clamp(1.9rem, 1.2rem + 2.4vw, 3.4rem);
		font-weight: 850;
		font-stretch: 116%;
		line-height: 1;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}
	.ad-head {
		display: grid;
		gap: 0.75rem;
		margin-bottom: 2rem;
	}
	.ad-lead {
		font-size: var(--step-lead);
		color: var(--ink-soft);
		max-width: 46ch;
		text-wrap: pretty;
	}

	/* Old against new: one ruled row per subject, the two sites side by side (stacked on a phone). */
	.ad-vs {
		padding-block: clamp(3rem, 8dvh, 6rem) 0;
	}
	.ad-vs-list {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--sheet-edge);
	}
	.ad-row {
		display: grid;
		gap: 1.5rem;
		padding-block: clamp(2rem, 5dvh, 3.25rem);
		border-bottom: 1px solid var(--sheet-edge);
	}
	.ad-row-h {
		display: flex;
		align-items: baseline;
		gap: 0.9rem;
		font-size: clamp(1.4rem, 1.05rem + 1.2vw, 2rem);
		font-weight: 800;
		font-stretch: 112%;
		line-height: 1.1;
	}
	.ad-row-n {
		font-size: 0.6em;
		font-weight: 700;
		color: var(--ink-soft);
		font-variant-numeric: tabular-nums;
	}
	.ad-row-pair {
		display: grid;
		gap: 2rem;
	}
	@media (min-width: 900px) {
		.ad-row-pair {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: clamp(2rem, 4vw, 3.5rem);
		}
	}
	.ad-side {
		display: grid;
		align-content: start;
		gap: 0.75rem;
		margin: 0;
	}
	.ad-side-label {
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--ink-soft);
	}
	.ad-side--new .ad-side-label {
		color: var(--ink);
	}
	.ad-side-shot {
		display: block;
		overflow: hidden;
		border-radius: 0.5rem;
		border: 1px solid var(--sheet-edge);
		aspect-ratio: 16 / 10;
		cursor: zoom-in;
	}
	.ad-side-shot img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
	}
	@media (hover: hover) {
		.ad-side-shot:hover img {
			transform: scale(1.02);
		}
	}
	.ad-side-text {
		font-size: var(--step-body);
		line-height: 1.6;
		text-wrap: pretty;
		max-width: 60ch;
	}
	.ad-row-changed {
		max-width: 72ch;
		padding-left: 1rem;
		border-left: 3px solid var(--accent-brand);
		font-size: var(--step-body);
		line-height: 1.5;
		text-wrap: pretty;
	}
	.ad-row-changed strong {
		font-weight: 800;
		margin-right: 0.35rem;
	}

	/* The numbers: one large figure each, what it measures, and what it was before. */
	.ad-numbers {
		padding-block: clamp(3rem, 8dvh, 6rem);
	}
	.ad-num-grid {
		display: grid;
		gap: 2.5rem 3rem;
		margin: 2.25rem 0 0;
		padding: 0;
		list-style: none;
	}
	@media (min-width: 720px) {
		.ad-num-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 1100px) {
		.ad-num-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
	.ad-num {
		display: grid;
		align-content: start;
		gap: 0.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--sheet-edge);
	}
	.ad-num-value {
		font-size: clamp(2.6rem, 1.6rem + 2.6vw, 4.4rem);
		font-weight: 850;
		font-stretch: 116%;
		line-height: 1;
		font-variant-numeric: tabular-nums;
	}
	.ad-num-label {
		font-weight: 700;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 0.75rem;
	}
	.ad-num-was {
		font-weight: 500;
		color: var(--ink-soft);
		text-decoration: line-through;
		text-decoration-thickness: 1px;
	}
	.ad-num-note {
		color: var(--ink-soft);
		text-wrap: pretty;
	}
	.ad-method {
		margin-top: 2.5rem;
		max-width: 80ch;
		font-size: 0.9rem;
		color: var(--ink-soft);
		text-wrap: pretty;
	}

	.ad-model {
		padding-block: clamp(3rem, 8dvh, 6rem) 0;
	}

	/* The write-up: the heading on the left, the words on the right, ruled like a drawing's notes. */
	.ad-sec {
		display: grid;
		gap: 1.25rem 4rem;
		padding-block: clamp(3rem, 7dvh, 5.5rem) clamp(1.5rem, 3dvh, 2.5rem);
	}
	@media (min-width: 1024px) {
		.ad-sec {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			align-items: start;
		}
		.ad-sec .ad-sec-h {
			position: sticky;
			top: 6.5rem;
			font-size: clamp(1.75rem, 1rem + 1.7vw, 2.6rem);
			line-height: 1.04;
		}
	}
	.ad-text {
		font-size: var(--step-body);
		line-height: 1.6;
		max-width: 64ch;
	}
	.ad-text :global(p + p) {
		margin-top: 1em;
	}
	.ad-text :global(ul) {
		list-style: none;
		margin: 1em 0 0;
		padding: 0;
		border-top: 1px solid var(--sheet-edge);
	}
	.ad-text :global(li) {
		padding: 0.85em 0;
		border-bottom: 1px solid var(--sheet-edge);
		text-wrap: pretty;
	}
	.ad-text :global(strong) {
		display: block;
		font-weight: 700;
	}
</style>
