---
import { getEntry, render } from "astro:content";
import BackLink from "@/components/BackLink.astro";
import IosTerminal from "@/components/IosTerminal.astro";
import ContactSection from "@/components/ContactSection.astro";
import ModelViewer from "@/components/model-viewer";
import PageIntro from "@/components/PageIntro.astro";
import StatusTag from "@/components/StatusTag.astro";
import SubnetSplit from "@/components/SubnetSplit.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

// Title, description, image and the written content live in src/content/work/cybersecurity.md.
const entry = (await getEntry("work", "cybersecurity"))!;
const { Content } = await render(entry);
const { data } = entry;

const legend = [
	{ color: "bg-chart-1", label: "VLAN 10" },
	{ color: "bg-chart-2", label: "VLAN 20" },
	{ color: "bg-chart-3", label: "Internet traffic the ACL allows" },
	{ color: "bg-chart-4", label: "Traffic the ACL drops" },
];
---

<BaseLayout title={`${data.title} | JPL Innovation`} description={data.description}>
	<PageIntro title={data.title} lede={data.description}>
		<div slot="before" class="flex flex-col gap-4">
			<BackLink href="/work/">All work</BackLink>
			{data.badge && <StatusTag>{data.badge}</StatusTag>}
		</div>
	</PageIntro>

	<section class="wrapper" aria-labelledby="lab-heading">
		<h2 id="lab-heading" class="sr-only">The lab network in 3D</h2>
		<figure class="flex flex-col gap-4" data-reveal data-reveal-delay="200">
			<div class="overflow-hidden rounded-xl border bg-card">
				<ModelViewer
					client:visible
					model="network"
					label="3D lab network: internet, an ACL shield, a router, a Layer 3 switch, two Layer 2 switches on VLAN 10 and VLAN 20, four PCs and a Windows Server, with packets flowing between them. One packet is dropped at the ACL; another changes colour as it is routed between VLANs."
					className="aspect-[4/3] w-full md:aspect-[21/10]"
				>
					<img src={data.img} alt={data.img_alt ?? ""} transition:name={`project-${entry.id}`} class="size-full object-cover" />
				</ModelViewer>
			</div>
			<figcaption class="flex flex-col gap-3">
				<ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
					{
						legend.map((item) => (
							<li class="flex items-center gap-2">
								<span class={`size-2.5 rounded-full ${item.color}`} aria-hidden="true" />
								{item.label}
							</li>
						))
					}
				</ul>
				<p class="text-sm text-muted-foreground">
					Watch a packet change colour as the L3 switch routes it from VLAN 10 to VLAN 20, and the shield flash when
					the ACL drops one.
				</p>
			</figcaption>
		</figure>
	</section>

	<article class="wrapper py-16 md:py-24">
		<div class="prose prose-lg prose-site max-w-[68ch]" data-reveal>
			<Content />
		</div>
	</article>

	<section class="border-y bg-card" aria-labelledby="ccna-heading">
		<div class="wrapper flex flex-col gap-10 py-20 md:py-28">
			<div class="flex max-w-2xl flex-col gap-3" data-reveal>
				<h2 id="ccna-heading" class="font-wide text-3xl font-[850] md:text-5xl">CCNA in motion</h2>
				<p class="text-lg text-muted-foreground">
					The configs behind the lab above, typed out on a Cisco console, and the subnet maths every network starts
					from.
				</p>
			</div>
			<div class="grid items-start gap-8 lg:grid-cols-[1.15fr_1fr] lg:gap-10">
				<div data-reveal><IosTerminal /></div>
				<div data-reveal data-reveal-delay="150"><SubnetSplit /></div>
			</div>
		</div>
	</section>

	<ContactSection />
</BaseLayout>
