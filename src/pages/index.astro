---
import { getCollection } from "astro:content";
// Component Imports
import CallToAction from "../components/CallToAction.astro";
import ContactCTA from "../components/ContactCTA.astro";
import FocusAreas from "../components/FocusAreas.astro";
import Grid from "../components/Grid.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import JourneyRoadmap from "../components/JourneyRoadmap.astro";
import MemberPreview from "../components/MemberPreview.astro";
import Mission from "../components/Mission.astro";
import PortfolioPreview from "../components/PortfolioPreview.astro";
import Skills from "../components/Skills.astro";
import WhyItMatters from "../components/WhyItMatters.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

// Content Fetching: first four projects and members, alphabetically
const byTitle = (a: { data: { title: string } }, b: { data: { title: string } }) =>
	a.data.title.toLowerCase().localeCompare(b.data.title.toLowerCase());

const projects = (await getCollection("work")).sort(byTitle).slice(0, 4);
const members = (await getCollection("members")).sort(byTitle).slice(0, 4);
---

<BaseLayout>
	<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-8 lg:gap-20">
			<header class="hero">
				<div class="hero-text">
					<p class="eyebrow">
						<span class="pulse" aria-hidden="true"></span>
						FRC Team 10951 · Student-led
					</p>
					<Hero
						title="Building tomorrow's technology, today"
						tagline="We're a student-led team focused on learning fast, building real projects, and turning curiosity into practical innovation."
						align="start"
					>
						<div class="hero-actions">
							<CallToAction href="/work/">
								See our work
								<Icon icon="arrow-right" size="1.2em" />
							</CallToAction>
							<a class="secondary-link" href="/members/">
								Meet the team
							</a>
						</div>
					</Hero>
				</div>

				<figure class="hero-image">
					<img
						alt="Team 10951's FRC robot on the practice field surrounded by yellow game pieces"
						width="2000"
						height="1333"
						src="/assets/FRC.JPG"
						fetchpriority="high"
					/>
					<figcaption>
						<Icon icon="rocket-launch" size="1.1em" /> 2026 competition robot
					</figcaption>
				</figure>
			</header>

			<div data-reveal><Skills /></div>

			<div data-reveal><Mission /></div>
		</div>

		<main class="wrapper stack gap-20 lg:gap-48">
			<FocusAreas />

			<div data-reveal><WhyItMatters /></div>

			<JourneyRoadmap />

			<section class="section with-background with-cta">
				<header class="section-header stack gap-2 lg:gap-4" data-reveal>
					<h3>Projects</h3>
					<p>Robotics, drones, and AI — what we've built and what we're building next.</p>
				</header>

				<div class="gallery" data-reveal style="--reveal-delay: 120ms">
					<Grid variant="offset">
						{
							projects.map((project) => (
								<li>
									<PortfolioPreview project={project} />
								</li>
							))
						}
					</Grid>
				</div>

				<div class="cta" data-reveal style="--reveal-delay: 240ms">
					<CallToAction href="/work/">
						View All
						<Icon icon="arrow-right" size="1.2em" />
					</CallToAction>
				</div>
			</section>

			<section class="section with-background with-cta">
				<header class="section-header stack gap-2 lg:gap-4" data-reveal>
					<h3>Members</h3>
					<p>The people behind JPL Innovation.</p>
				</header>

				<div class="gallery" data-reveal style="--reveal-delay: 120ms">
					<Grid variant="offset">
						{
							members.map((member) => (
								<li>
									<MemberPreview member={member} />
								</li>
							))
						}
					</Grid>
				</div>

				<div class="cta" data-reveal style="--reveal-delay: 240ms">
					<CallToAction href="/members/">
						View All
						<Icon icon="arrow-right" size="1.2em" />
					</CallToAction>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2.5rem;
	}

	.hero-text {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
		animation: rise 900ms var(--ease-out) both;
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.35rem 0.9rem;
		border-radius: 999rem;
		border: 1px solid var(--border-accent);
		background: var(--accent-overlay);
		color: var(--gray-100);
		font-size: var(--text-sm);
		font-weight: 700;
	}

	.pulse {
		position: relative;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--accent-light);
	}

	.pulse::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: inherit;
		animation: ping 2s var(--ease-out) infinite;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 1rem 1.75rem;
		margin-top: 0.75rem;
	}

	.secondary-link {
		color: var(--gray-100);
		font-family: var(--font-brand);
		font-weight: 500;
		text-decoration: underline 2px transparent;
		text-underline-offset: 0.35em;
		transition: text-decoration-color var(--theme-transition), color var(--theme-transition);
	}

	.secondary-link:hover,
	.secondary-link:focus-visible {
		color: var(--gray-0);
		text-decoration-color: var(--accent-light);
	}

	.hero-image {
		position: relative;
		width: 100%;
		max-width: 36rem;
		animation: rise 1100ms 120ms var(--ease-out) both;
	}

	.hero-image::before {
		/* Soft glow behind the photo. */
		content: "";
		position: absolute;
		inset: 8% -4% -6% 4%;
		z-index: -1;
		border-radius: 2rem;
		background: var(--gradient-accent-orange);
		filter: blur(40px);
		opacity: 0.45;
	}

	.hero-image img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		object-position: 55% 70%;
		border-radius: 1.5rem;
		border: 1px solid var(--border-subtle);
		box-shadow: var(--shadow-xl);
	}

	.hero-image figcaption {
		position: absolute;
		left: 1rem;
		bottom: 1rem;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.45rem 0.9rem;
		border-radius: 999rem;
		background: rgba(9, 11, 17, 0.6);
		backdrop-filter: blur(8px);
		color: #fff;
		font-size: var(--text-sm);
		font-weight: 700;
	}

	@keyframes rise {
		from {
			opacity: 0;
			translate: 0 2rem;
		}
	}

	@keyframes ping {
		75%,
		100% {
			transform: scale(2.6);
			opacity: 0;
		}
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 6fr 5fr;
			align-items: center;
			gap: 3.75rem;
		}

		.hero-text {
			align-items: flex-start;
		}

		.hero-actions {
			justify-content: flex-start;
		}

		.hero-image {
			max-width: none;
		}

		.hero-image img {
			aspect-ratio: 4 / 5;
			border-radius: 3rem;
		}

		.hero-image figcaption {
			left: 1.5rem;
			bottom: 1.5rem;
		}
	}

	/* ====================================================== */

	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);

		content: "";
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: 0;
		transform: translateY(-75%) translateX(-50%);
		background:
			url("/assets/backgrounds/noise.png") top center/220px repeat,
			var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
			var(--gray-999);
		background-blend-mode: overlay, normal, normal, normal;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header h3 {
		font-size: var(--text-2xl);
	}

	.cta {
		display: flex;
		justify-content: center;
	}

	@media (min-width: 50em) {
		.section {
			grid-template-columns: 1fr 3fr;
			grid-template-areas: "header gallery" "header gallery";
			gap: 4rem 6rem;
			align-items: start;
		}

		/* "View All" sits under the heading so the gallery gets the full width. */
		.section.with-cta {
			grid-template-rows: auto 1fr;
			grid-template-areas: "header gallery" "cta gallery";
			row-gap: 2rem;
		}

		/* Not sticky here, or the heading would slide over the "View All" button. */
		.with-cta .section-header {
			position: static;
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
			position: sticky;
			top: 7rem;
			justify-self: start;
			text-align: left;
			max-width: 15ch;
		}

		.section-header h3 {
			font-size: var(--text-3xl);
			margin-bottom: 1rem;
		}

		.section-header p {
			font-size: var(--text-sm);
			line-height: 1.6;
		}

		.gallery {
			grid-area: gallery;
		}

		.cta {
			grid-area: cta;
			align-self: start;
			justify-self: start;
		}
	}
</style>
